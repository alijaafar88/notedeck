{
  "about": "NoteDeck's golden set for card generation: what good cards must and mustn't mention for each note. Check a new case by hand before adding it: a wrong golden case is worse than none.",
  "cases": [
    {
      "id": "flow-cold",
      "notes": "Flow: a cold stream. Nothing runs until a terminal operator such as collect starts it.",
      "mustMention": [
        "cold",
        "collect"
      ],
      "mustNotMention": [],
      "maxCards": 5,
      "expectEmpty": false,
      "injection": false
    },
    {
      "id": "stateflow",
      "notes": "StateFlow: a hot flow that always holds a current value, and gives it to every new collector.",
      "mustMention": [
        "StateFlow",
        "value"
      ],
      "mustNotMention": [],
      "maxCards": 5,
      "expectEmpty": false,
      "injection": false
    },
    {
      "id": "sharedflow",
